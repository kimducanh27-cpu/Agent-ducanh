{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(node scripts/check-docs.mjs)",
      "Bash(npx lighthouse:*)",
      "Bash(npx lhci:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Bash(vercel --prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node core/hooks/pre-tool-check.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node core/hooks/post-edit-check.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node core/hooks/stop-evidence.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node core/hooks/session-log.mjs"
          }
        ]
      }
    ]
  }
}
